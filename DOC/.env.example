# ============================================================
# DFX_ate environment configuration  (SINGLE SOURCE OF TRUTH)
# ------------------------------------------------------------
# Copy this file to ".env" placed NEXT TO DFX_Tester.exe
# (or at the repo root during development). Do NOT commit .env.
# Non-secret keys are optional; password keys must be set in .env.
# ============================================================

# --- Secrets ---
LOG_ENCRYPTION_PASSWORD=XXX
ADMIN_REPORT_PASSWORD=XXX

# --- Default admin seed (applied only on first database creation) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMPLOYEE_ID=0000

# --- Application identity ---
APP_VERSION=0.1.0-Beta
TESTER_SERIAL_NUMBER=ATE-DFX-001
# One entry per load channel (CH1 first); the count sets the number of channels.
# Fallback S/N only: the Admin sets each module's S/N in Connections > Load modules,
# which wins over this and needs no restart.
LOAD_SERIALS=PRODIGIT-CH1,PRODIGIT-CH2,PRODIGIT-CH3,PRODIGIT-CH4

# --- Feature flags (true/false) ---
SHOW_SEARCH_BAR=false

# --- Pre-test UUT options (comma-separated) ---
UUT_TYPES=EM-5406-00,EM-5406-00F

# --- Folder that collects a copy of every CAMSTAR XML report ---
# Empty = data\results\XML. May be a network share, e.g. \\server\camstar\in
XML_EXPORT_DIR=

# --- Electronic load connection (also settable in Admin > Connections) ---
# LAN:                 TCPIP0::192.168.16.123::4001::SOCKET
# USB as a COM port:   COM3   (same as ASRL3::INSTR)
# USBTMC:              USB0::<vendor>::<product>::<serial>::INSTR
# Empty = auto-discover (USB, or a COM port that answers *IDN? as a Prodigit).
PRODIGIT_VISA_RESOURCE=
# The lines below are the code defaults (station-tested 2026-10-29); listed so
# they are visible. CHAN {slot} must stay: without it every command goes to one
# channel and a parallel run tests all units on it.
PRODIGIT_VISA_BACKEND=@py
PRODIGIT_SELECT_SLOT=CHAN {slot}
PRODIGIT_QUERY_POLARITY=MEAS:VOLT?
PRODIGIT_SET_RESISTANCE=MODE CR;CR:HIGH {value}
# COM-port link only: baud rate, to match the 3300G front-panel setting.
PRODIGIT_SERIAL_BAUD=9600
# Written once after each connect; the 3300G manual asks for REMOTE over USB/LAN.
# LAN works without it - set it if the USB link needs it.
PRODIGIT_CONNECT_CMD=
